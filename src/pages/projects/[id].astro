---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects', ({ data }) => !data.draft);
	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Base title={`${project.data.title} — Shared Portfolio`} description={project.data.summary}>
	<article class="project">
		<a class="back" href="/">&larr; all work</a>
		<span class="tag">
			case study — {project.data.status === 'in-progress' ? 'in progress' : project.data.year}
		</span>
		<h1>{project.data.title}</h1>
		<p class="summary">{project.data.summary}</p>
		<div class="body">
			<Content />
		</div>
		<div class="foot">
			<span class="sig">— {project.data.author}</span>
			<span class="role">{project.data.role.toUpperCase()}</span>
		</div>
	</article>
</Base>

<style>
	.project {
		max-width: 680px;
		margin: 0 auto;
		padding: 72px 28px 96px;
	}
	.back {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--slate);
		text-decoration: none;
		display: inline-block;
		margin-bottom: 32px;
	}
	.back:hover {
		color: var(--berry);
	}
	.tag {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--moss);
		margin-bottom: 14px;
		display: block;
	}
	h1 {
		font-size: clamp(32px, 5vw, 48px);
		line-height: 1.08;
		margin-bottom: 18px;
	}
	.summary {
		font-size: 18px;
		color: var(--ink-soft);
		margin: 0 0 40px;
		max-width: 60ch;
	}
	.body {
		font-size: 17px;
		line-height: 1.7;
		color: var(--ink-soft);
	}
	.body :global(p) {
		margin: 0 0 22px;
	}
	.foot {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-top: 1px solid var(--line);
		margin-top: 48px;
		padding-top: 20px;
	}
	.sig {
		font-family: var(--font-script);
		font-weight: 600;
		font-size: 24px;
		color: var(--berry);
	}
	.role {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--slate);
	}
</style>
