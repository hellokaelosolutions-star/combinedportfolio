		box-shadow: 0 16px 30px rgba(0, 0, 0, 0.24);
		z-index: 5;
	}
	.trophy-top-bar {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 4px;
	}
	.trophy-card:nth-child(odd) .trophy-top-bar {
		background: var(--berry);
	}
	.trophy-card:nth-child(even) .trophy-top-bar {
