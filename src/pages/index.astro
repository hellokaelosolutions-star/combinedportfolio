		flex-wrap: wrap;
		gap: 14px;
	}
	.contact-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 13px 24px;
		font-family: var(--font-mono);
		font-size: 13px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		text-decoration: none;
		border: 1px solid var(--accent);
		color: var(--accent);
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}
	.contact-btn:hover {
		background: var(--accent);
		color: var(--paper);
	}

	.orb {
		transition: transform 0.3s ease;
	}

	.reveal {
		opacity: 0;
		transform: translateY(18px);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
	}
	.reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
	}
	.reveal-fade {
		opacity: 0;
		transition: opacity 0.6s ease;
	}
	.reveal-fade.is-visible {
		opacity: 1;
	}
	@media (prefers-reduced-motion: reduce) {
		.reveal,
		.reveal-fade {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}

	.confetti-piece {
		position: absolute;
		width: 6px;
		height: 6px;
		pointer-events: none;
		animation: confetti-burst 0.7s ease-out forwards;
		z-index: 20;
	}
	@keyframes confetti-burst {
		0% {
			transform: translate(0, 0) rotate(0deg);
			opacity: 1;
		}
		100% {
			transform: translate(var(--dx), var(--dy)) rotate(var(--rot));
			opacity: 0;
		}
	}
</style>

<script>
	// Cursor-reactive hero orbs
	const heroMark = document.querySelector<HTMLElement>('.hero-mark');
	const orbs = document.querySelectorAll<HTMLElement>('.hero-mark .orb');
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (heroMark && orbs.length && !reduceMotion) {
		heroMark.addEventListener('mousemove', (e) => {
			const rect = heroMark.getBoundingClientRect();
			const x = (e.clientX - rect.left) / rect.width - 0.5;
			const y = (e.clientY - rect.top) / rect.height - 0.5;
			orbs.forEach((orb, i) => {
				const strength = i === 0 ? 10 : 16;
				orb.style.transform = `translate(${x * strength}px, ${y * strength}px)`;
			});
		});
		heroMark.addEventListener('mouseleave', () => {
			orbs.forEach((orb) => {
				orb.style.transform = '';
			});
		});
	}

	// Scroll-reveal
	const revealEls = document.querySelectorAll('.reveal, .reveal-fade');
	if (reduceMotion) {
		revealEls.forEach((el) => el.classList.add('is-visible'));
	} else if ('IntersectionObserver' in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				}
			},
			{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
		);
		revealEls.forEach((el) => observer.observe(el));
	} else {
		revealEls.forEach((el) => el.classList.add('is-visible'));
	}

	// Trophy card hover confetti
	if (!reduceMotion) {
		const confettiColors = ['var(--berry)', 'var(--moss)', 'var(--slate)'];
		document.querySelectorAll<HTMLElement>('.trophy-card').forEach((card) => {
			card.addEventListener('mouseenter', () => {
				for (let i = 0; i < 12; i++) {
					const piece = document.createElement('span');
					piece.className = 'confetti-piece';
					const angle = Math.random() * Math.PI * 2;
					const dist = 36 + Math.random() * 36;
					piece.style.setProperty('--dx', `${Math.cos(angle) * dist}px`);
					piece.style.setProperty('--dy', `${Math.sin(angle) * dist - 18}px`);
					piece.style.setProperty('--rot', `${(Math.random() - 0.5) * 360}deg`);
					piece.style.background = confettiColors[i % confettiColors.length];
					piece.style.left = `${20 + Math.random() * 60}%`;
					piece.style.top = `${15 + Math.random() * 25}%`;
					card.appendChild(piece);
					piece.addEventListener('animationend', () => piece.remove());
				}
			});
		});
	}
</script>
