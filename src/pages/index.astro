	.trophy-detail {
		font-family: var(--font-mono);
		font-size: 11.5px;
		color: var(--slate);
		line-height: 1.55;
		margin: 0;
	}
	@media (max-width: 700px) {
		.trophy-stack {
			flex-direction: column;
			align-items: center;
			gap: 20px;
		}
		.trophy-card,
		.trophy-card:nth-child(odd),
		.trophy-card:nth-child(even) {
