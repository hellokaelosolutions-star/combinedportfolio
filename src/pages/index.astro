		}
	}

	.banner {
		padding: 28px 32px;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 6px 18px;
	}
	.banner-gradient {
		background: linear-gradient(90deg, var(--berry), var(--moss));
	}
	.banner-empty {
		background: none;
		border: 1px dashed var(--line);
	}
	.banner-empty .banner-title,
	.banner-empty .banner-detail {
		color: var(--slate);
	}
	.banner-title {
		font-family: var(--font-script);
		font-weight: 600;
		font-size: 32px;
		color: var(--paper);
